<%# Cotizador — port del widget WordPress hurricane-solution-widget (Fase 5.10). %>
<%# Markup adaptado para SSR EJS. La lógica vive en client/widget.ts. %>
<%# El form NO postea directo a Make.com — pasa por /api/lead (Fase 7) para %>
<%# ocultar el webhook real y aplicar Zod + honeypot + rate-limit en server. %>
<%# PENDIENTE: portar CSS del widget desde el plugin a public/css/hurricane-widget.css. %>

<div class="hurricane-widget-container">
  <div class="container">

    <section class="hero">
      <h1><%= t('cotizador.page_title') %></h1>
      <p><%= t('widget.subtitle') %></p>
    </section>

    <div class="badges-container">
      <div class="badges-track">
        <% const badges = [
          { label: 'Certificado EE.UU.' },
          { label: 'Patentes Exclusivas' },
          { label: 'Garantía hasta 10 años' },
          { label: '+500 Proyectos' }
        ]; %>
        <% for (let i = 0; i < 2; i++) { %>
          <% badges.forEach(b => { %>
            <div class="badge"><span><%= b.label %></span></div>
          <% }) %>
        <% } %>
      </div>
    </div>

    <div class="main-card">

      <div class="intro-text">
        <h2><%= t('widget.title') %></h2>
        <p><%= t('widget.subtitle') %></p>
      </div>

      <div id="hurricaneFormSection">

        <div class="step">
          <div class="step-label"><span class="step-number">1</span><span class="step-title"><%= t('widget.step1_title') %></span></div>
          <div class="input-wrapper">
            <input type="text" class="text-input" id="hurricaneLocationInput" placeholder="<%= t('widget.step1_placeholder') %>" autocomplete="off">
            <div class="autocomplete" id="hurricaneAutocomplete"></div>
          </div>
        </div>

        <div class="step">
          <div class="step-label"><span class="step-number">2</span><span class="step-title"><%= t('widget.step2_title') %></span></div>
          <div class="select-wrapper">
            <select class="select-input" id="hurricanePropertySelect">
              <option value=""><%= t('widget.step2_default') %></option>
              <option value="casa"><%= t('widget.opt_house') %></option>
              <option value="departamento"><%= t('widget.opt_apt') %></option>
              <option value="hotel"><%= t('widget.opt_hotel') %></option>
              <option value="comercio"><%= t('widget.opt_commercial') %></option>
              <option value="proyecto_construccion"><%= t('widget.opt_project') %></option>
              <option value="torre"><%= t('widget.opt_tower') %></option>
            </select>
          </div>
        </div>

        <div class="price-box" id="hurricanePriceBox">
          <div class="price-badge"><%= t('widget.price_badge') %></div>
          <p class="price-location">En <strong id="hurricanePriceLocation"><%= t('widget.price_location') %></strong></p>
          <p class="price-amount" id="hurricanePriceAmount">$130 - $170</p>
          <p class="price-unit"><%= t('widget.price_unit') %></p>
          <p class="price-note" id="hurricanePriceNote"><%= t('widget.price_note') %></p>
          <p class="price-cta-label"><%= t('widget.price_cta_label') %></p>
          <button type="button" class="btn-interest" id="hurricaneInterestBtn"><%= t('widget.price_cta_btn') %></button>
        </div>

        <div class="contact-box" id="hurricaneContactBox">
          <div class="contact-title">
            <h3><%= t('widget.contact_title') %></h3>
            <p><%= t('widget.contact_subtitle') %></p>
          </div>
          <form id="hurricaneQuoteForm" data-form="quote" action="/api/lead" method="POST" novalidate>
            <input type="text" name="hp_field" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true" />
            <input type="hidden" name="source" value="Landing Cotizador" />
            <input type="hidden" name="ts" value="<%= Date.now() %>" />
            <div class="form-row">
              <input id="hurricaneNameInput" class="form-input" name="full_name" type="text" placeholder="Tu nombre" required>
              <input id="hurricanePhoneInput" class="form-input" name="phone" type="tel" inputmode="tel" placeholder="WhatsApp (10 dígitos)" required>
            </div>
            <button type="submit" class="btn-whatsapp" id="hurricaneSubmitBtn" disabled><%= t('widget.contact_submit') %></button>
            <p class="btn-hint"><%= t('widget.contact_hint') %></p>
            <button type="button" class="btn-back" id="hurricaneBackBtn"><%= t('widget.contact_back') %></button>
          </form>
        </div>

      </div>

      <div class="success-box" id="hurricaneSuccessBox">
        <div class="success-icon">✓</div>
        <h3><%= t('widget.success_title') %></h3>
        <p><%= t('widget.success_body') %></p>
        <button type="button" class="btn-reload"><%= t('widget.success_btn') %></button>
      </div>

    </div>

    <div class="info-section">
      <div class="warranty">
        <div class="warranty-title"><%= t('widget.warranty_title') %></div>
        <div class="warranty-items">
          <div class="warranty-item"><strong>HS-1500:</strong> <%= t('common.years_10') %></div>
          <div class="warranty-item"><strong>HS-1250:</strong> <%= t('common.years_7') %></div>
          <div class="warranty-item"><strong>HS-875:</strong> <%= t('common.years_5') %></div>
        </div>
      </div>
    </div>

  </div>
</div>

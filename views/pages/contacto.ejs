<!-- Schema ContactPage + ai-summary — contacto -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contacto — Hurricane Solution",
  "description": "Solicite evaluación gratuita de protección contra huracanes. Hurricane Solution responde en menos de 24 horas. Oficinas en Playa del Carmen, Quintana Roo.",
  "mainEntity": {
    "@type": "Organization",
    "name": "Hurricane Solution",
    "telephone": "+529848035014",
    "email": "info@hurricanesolution.com",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "10 Avenida Norte entre 14 Norte bis y 16 Norte",
      "addressLocality": "Playa del Carmen",
      "addressRegion": "Quintana Roo",
      "postalCode": "77500",
      "addressCountry": "MX"
    },
    "areaServed": ["Cancún","Playa del Carmen","Tulum","Riviera Maya","<%= t('contacto.zone_cabos') %>","<%= t('contacto.zone_vallarta') %>","<%= t('contacto.zone_mazatlan') %>","<%= t('contacto.zone_acapulco') %>","México"],
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+529848035014",
      "contactType": "sales",
      "availableLanguage": ["Spanish"],
      "areaServed": "MX"
    }
  }
}
</script>

<section class="ai-summary" aria-label="Resumen para búsqueda">
  <p>Hurricane Solution ofrece evaluación técnica gratuita y sin compromiso para propiedades en zonas costeras de México. Contacto disponible por teléfono al 984 803 5014, WhatsApp al +52 1 998 705 2145, o correo info@hurricanesolution.com. Oficinas en Playa del Carmen, Quintana Roo. Respuesta garantizada en menos de 24 horas hábiles. Sirve a hoteles, residencias, empresas y propiedades comerciales en Cancún, Tulum, Riviera Maya, Los Cabos, Puerto Vallarta, Mazatlán y Acapulco.</p>
</section>

<%# Contacto — portada desde pages/contacto.html legacy (Fase 5.9). %>
<%# Form preparado para /api/lead con source="Landing Contacto", honeypot y ts. %>
<%# El submit real (validación + fetch) llega en Fase 6/8. %>

<div class="ip-hero">
  <h1><%- t('contacto.hero_title') %></h1>
  <p><%= t('contacto.hero_body') %></p>
</div>

<section><div class="wrap">
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:start">
    <div class="fcard reveal">
      <h3><%= t('contacto.form_label') %></h3>
      <p><%= t('contacto.form_response') %></p>
      <form data-form="lead" action="/api/lead" method="POST" novalidate>
        <input type="text" name="hp_field" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true" />
        <input type="hidden" name="source" value="Landing Contacto" />
        <input type="hidden" name="ts" value="<%= Date.now() %>" />
        <div class="frow">
          <div class="fg"><label for="ct-nombre"><%= t('contacto.field_name') %></label><input id="ct-nombre" type="text" name="nombre" placeholder="Nombre" required></div>
          <div class="fg"><label for="ct-apellido"><%= t('contacto.field_lastname') %></label><input id="ct-apellido" type="text" name="apellido" placeholder="Apellido"></div>
        </div>
        <div class="fg"><label for="ct-phone"><%= t('contacto.field_phone') %></label><input id="ct-phone" type="tel" name="phone" placeholder="+52 984 000 0000" required></div>
        <div class="fg"><label for="ct-email"><%= t('contacto.field_email') %></label><input id="ct-email" type="email" name="email" placeholder="correo@empresa.com" required></div>
        <div class="fg"><label for="ct-tipo"><%= t('contacto.field_type') %></label>
          <select id="ct-tipo" name="tipo_propiedad" required><option value=""><%= t('contacto.field_type_default') %></option><option><%= t('contacto.opt_hotel') %></option><option><%= t('contacto.opt_company') %></option><option><%= t('contacto.opt_residence') %></option><option><%= t('contacto.opt_auto') %></option><option><%= t('contacto.opt_hospital') %></option><option><%= t('contacto.opt_development') %></option><option><%= t('contacto.opt_aquagrid') %></option><option><%= t('contacto.opt_rain') %></option><option><%= t('contacto.opt_other') %></option></select>
        </div>
        <div class="fg"><label for="ct-zona">Zona</label>
          <select id="ct-zona" name="zona"><option value=""><%= t('contacto.field_zone_default') %></option><option><%= t('contacto.zone_riviera') %></option><option><%= t('contacto.zone_cancun') %></option><option>Cozumel</option><option>Tulum</option><option><%= t('contacto.zone_cabos') %></option><option>Puerto Vallarta</option><option><%= t('contacto.zone_mazatlan') %></option><option>Acapulco</option><option>Otra</option></select>
        </div>
        <div class="fg"><label for="ct-mensaje"><%= t('contacto.field_message') %></label><input id="ct-mensaje" type="text" name="mensaje" placeholder="Cuéntenos brevemente sobre su propiedad..."></div>
        <button type="submit" class="fsub"><%= t('contacto.btn_send') %></button>
        <p class="fnote"><%= t('contacto.form_footer') %></p>
      </form>
    </div>
    <div class="reveal">
      <div class="stag"><%= t('contacto.direct_label') %></div>
      <h2 class="stit" style="font-size:1.4rem">Le atendemos <span>de inmediato</span></h2>
      <div style="margin-top:1.5rem;display:flex;flex-direction:column;gap:1rem">
        <a href="<%= site.whatsapp.url %>" rel="noopener" target="_blank" style="display:flex;align-items:center;gap:1rem;background:#25D366;color:#fff;padding:1.1rem 1.5rem;border-radius:6px;font-family:'Montserrat',sans-serif;font-weight:700;font-size:.88rem">
          <div><div>WhatsApp</div><div style="font-weight:400;font-size:.78rem;opacity:.85"><%= site.whatsapp.display %> <%= t('contacto.wa_sub') %></div></div>
        </a>
        <a href="<%= site.phone.href %>" style="display:flex;align-items:center;gap:1rem;background:var(--blue);color:#fff;padding:1.1rem 1.5rem;border-radius:6px;font-family:'Montserrat',sans-serif;font-weight:700;font-size:.88rem">
          <div><div><%= t('contacto.tel_label') %></div><div style="font-weight:400;font-size:.78rem;opacity:.85"><%= site.phone.display %> <%= t('contacto.tel_sub') %></div></div>
        </a>
        <a href="mailto:<%= site.email %>" style="display:flex;align-items:center;gap:1rem;background:var(--navy);color:#fff;padding:1.1rem 1.5rem;border-radius:6px;font-family:'Montserrat',sans-serif;font-weight:700;font-size:.88rem">
          <div><div><%= t('contacto.email_label') %></div><div style="font-weight:400;font-size:.78rem;opacity:.85"><%= site.email %></div></div>
        </a>
      </div>
      <div style="margin-top:1.25rem;padding:1.5rem;background:var(--off);border-radius:6px;border:1.5px solid var(--border)">
        <h4 style="font-size:.88rem;color:var(--navy);margin-bottom:.5rem"><%= t('contacto.offices_label') %></h4>
        <p style="font-size:.84rem;color:var(--gray);line-height:1.65"><%= site.address.street %><br><%= site.address.neighborhood %>, <%= site.address.postalCode %> <%= site.address.city %>, Q.R.<br><%= site.address.country %></p>
      </div>
      <div style="margin-top:1rem;padding:1.25rem;background:var(--off);border-radius:6px;border:1.5px solid var(--border)">
        <h4 style="font-size:.88rem;color:var(--navy);margin-bottom:.5rem"><%= t('contacto.social_label') %></h4>
        <div style="display:flex;gap:.75rem;flex-wrap:wrap;margin-top:.35rem">
          <a href="<%= site.social.facebook %>" rel="noopener" target="_blank" style="font-size:.78rem;color:var(--blue);font-family:'Montserrat',sans-serif;font-weight:600">Facebook</a>
          <a href="<%= site.social.instagram %>" rel="noopener" target="_blank" style="font-size:.78rem;color:var(--blue);font-family:'Montserrat',sans-serif;font-weight:600">Instagram</a>
          <a href="<%= site.social.youtube %>" rel="noopener" target="_blank" style="font-size:.78rem;color:var(--blue);font-family:'Montserrat',sans-serif;font-weight:600">YouTube</a>
          <a href="<%= site.social.tiktok %>" rel="noopener" target="_blank" style="font-size:.78rem;color:var(--blue);font-family:'Montserrat',sans-serif;font-weight:600">TikTok</a>
        </div>
      </div>
    </div>
  </div>
</div></section>
